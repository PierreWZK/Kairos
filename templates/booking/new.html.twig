{% extends 'base.html.twig' %}

{% block title %}Vos coordonnées · Kairos{% endblock %}

{% block body %}
{{ include('_header.html.twig') }}

<main class="page">
    <div class="container">
        <a class="back-link" href="{{ path('app_booking_agenda', {id: service.id, semaine: booking.startsAt|date('Y-m-d')}) }}">← Choisir un autre créneau</a>

        <p class="eyebrow">Étape 3 sur 3</p>
        <h1 class="page-title">Vos coordonnées</h1>
        <p class="page-lede">Pas de compte à créer : un nom et un e-mail suffisent.</p>

        <div class="checkout">
            {{ include('booking/_summary.html.twig') }}

            {{ form_start(form, {attr: {class: 'booking-form', novalidate: 'novalidate'}}) }}
                {# Erreurs qui ne concernent aucun champ en particulier (jeton CSRF, par exemple) #}
                {% if form.vars.errors|length %}
                    <div class="flash flash-warning">{{ form_errors(form) }}</div>
                {% endif %}
                {{ form_row(form.customerName) }}
                {{ form_row(form.customerEmail) }}
                {{ form_row(form.customerPhone, {label: 'Téléphone <span class="optional">facultatif</span>', label_html: true}) }}
                {{ form_row(form.note, {label: 'Un mot pour préparer le rendez-vous <span class="optional">facultatif</span>', label_html: true}) }}
                <button type="submit" class="button button-primary">Confirmer le rendez-vous</button>
            {{ form_end(form) }}
        </div>
    </div>
</main>

{{ include('_footer.html.twig') }}
{% endblock %}

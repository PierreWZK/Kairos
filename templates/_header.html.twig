<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="{{ path('app_home') }}">
            <span class="brand-mark" aria-hidden="true"></span>
            Kairos
        </a>
        <nav class="nav" aria-label="Navigation principale">
            <a href="{{ path('app_home') }}#fonctionnement">Fonctionnement</a>
            <a href="{{ path('app_home') }}#fonctionnalites">Fonctionnalités</a>
            <a href="{{ path('app_home') }}#integration">Intégration</a>
            <a href="{{ path('app_home') }}#demos">Démos</a>
        </nav>
        <div class="header-actions">
            {% if app.user %}
                <a class="header-link" href="{{ path('app_logout') }}">Déconnexion</a>
                <a class="button button-primary button-small" href="{{ path('app_space') }}">Mon espace</a>
            {% else %}
                <a class="header-link" href="{{ path('app_login') }}">Se connecter</a>
                <a class="button button-primary button-small" href="{{ path('app_register') }}">Créer mon espace</a>
            {% endif %}
        </div>
    </div>
</header>

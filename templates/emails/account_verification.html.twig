{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <p style="margin:0;">Bonjour {{ user.name }},</p>
    <p>Bienvenue sur Kairos ! Pour activer l'espace de <strong>{{ user.company.name }}</strong>, confirmez votre adresse e-mail :</p>
    <p style="margin:24px 0;">
        <a href="{{ url }}" style="display:inline-block; padding:12px 20px; background:#0f5c56; border-radius:999px; color:#f6f1e7; font-weight:bold; text-decoration:none;">Confirmer mon adresse</a>
    </p>
    <p style="color:#5d6b69; font-size:13px;">Ce lien est valable 48 heures. Si vous n'avez pas créé de compte sur Kairos, ignorez cet e-mail.</p>
{% endblock %}

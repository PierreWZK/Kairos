{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <p style="margin:0;">Bonjour {{ booking.customerName }},</p>
    {% if cancelled_by_owner %}
        <p>Nous sommes désolés : votre rendez-vous auprès de <strong>{{ company.name }}</strong> a dû être annulé de notre côté.</p>
    {% else %}
        <p>Votre rendez-vous auprès de <strong>{{ company.name }}</strong> a bien été annulé :</p>
    {% endif %}

    {{ include('emails/_booking_card.html.twig') }}

    <p>{{ cancelled_by_owner ? 'Vous pouvez choisir un autre créneau quand vous le souhaitez :' : 'Le créneau est de nouveau proposé aux autres clients. Si vous souhaitez reprendre rendez-vous :' }}</p>
    <p style="margin:24px 0;">
        <a href="{{ url('app_company', {company: company.slug}) }}" style="display:inline-block; padding:12px 20px; background:#0f5c56; border-radius:999px; color:#f6f1e7; font-weight:bold; text-decoration:none;">Réserver un nouveau créneau</a>
    </p>
    <p style="margin-bottom:0;">À bientôt !</p>
{% endblock %}

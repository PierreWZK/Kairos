{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <p style="margin:0;">Bonjour {{ user.name }},</p>
    <p>Une demande de nouveau mot de passe a été faite pour votre compte Kairos. Pour en choisir un :</p>
    <p style="margin:24px 0;">
        <a href="{{ url }}" style="display:inline-block; padding:12px 20px; background:#0f5c56; border-radius:999px; color:#f6f1e7; font-weight:bold; text-decoration:none;">Choisir un nouveau mot de passe</a>
    </p>
    <p style="color:#5d6b69; font-size:13px;">Ce lien est valable une heure et ne sert qu'une fois. Si vous n'êtes pas à l'origine de cette demande, ignorez cet e-mail : votre mot de passe actuel reste valable.</p>
{% endblock %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ email.subject }}</title>
</head>
{# Styles en ligne : la plupart des messageries ignorent les feuilles de style #}
<body style="margin:0; padding:0; background:#f6f1e7; font-family:Arial, Helvetica, sans-serif; color:#1c2a2a;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f1e7;">
    <tr>
        <td align="center" style="padding:32px 16px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background:#fffdf8; border:1px solid #e2d8c6; border-radius:14px;">
                <tr>
                    <td style="padding:24px 32px 0; font-family:Georgia, serif; font-size:22px; font-weight:bold; color:#0f5c56;">Kairos</td>
                </tr>
                <tr>
                    <td style="padding:16px 32px 32px; font-size:15px; line-height:1.6;">
                        {% block content %}{% endblock %}
                    </td>
                </tr>
            </table>
            <p style="margin:16px 0 0; font-size:12px; color:#5d6b69;">Kairos · réservation de créneaux en ligne</p>
        </td>
    </tr>
</table>
</body>
</html>

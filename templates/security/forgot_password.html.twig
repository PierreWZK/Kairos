{% extends 'security/_layout.html.twig' %}

{% block title %}Mot de passe oublié · Kairos{% endblock %}

{% block content %}
<p class="eyebrow">Espace entreprise</p>
<h1 class="page-title">Mot de passe oublié</h1>
<p class="page-lede">Indiquez l'adresse de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>

{{ form_start(form, {attr: {class: 'booking-form', novalidate: 'novalidate'}}) }}
    {% if form.vars.errors|length %}
        <div class="flash flash-warning">{{ form_errors(form) }}</div>
    {% endif %}
    {{ form_row(form.email) }}
    <button type="submit" class="button button-primary">Recevoir le lien</button>
{{ form_end(form) }}

<div class="auth-links">
    <a href="{{ path('app_login') }}">← Retour à la connexion</a>
</div>
{% endblock %}

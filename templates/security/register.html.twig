{% extends 'security/_layout.html.twig' %}

{% block title %}Créer mon espace · Kairos{% endblock %}
{% block auth_class %} auth-wide{% endblock %}

{% block content %}
<p class="eyebrow">Inscription gratuite</p>
<h1 class="page-title">Créez l'espace de votre entreprise</h1>
<p class="page-lede">Deux minutes suffisent. Vous configurerez ensuite vos calendriers et vos prestations.</p>

{{ form_start(form, {attr: {class: 'booking-form', novalidate: 'novalidate'}}) }}
    {% if form.vars.errors|length %}
        <div class="flash flash-warning">{{ form_errors(form) }}</div>
    {% endif %}

    <p class="form-group-title">Votre entreprise</p>
    {{ form_row(form.companyName) }}
    <div>
        {{ form_label(form.companySlug) }}
        {{ form_widget(form.companySlug) }}
        <p class="slug-preview">{{ url('app_home') }}<strong data-slug-preview="votre-entreprise">{{ form.companySlug.vars.value ?: 'votre-entreprise' }}</strong></p>
        {{ form_help(form.companySlug) }}
        {{ form_errors(form.companySlug) }}
    </div>
    {{ form_row(form.timezone) }}

    <p class="form-group-title">Vous</p>
    {{ form_row(form.name) }}
    {{ form_row(form.email) }}
    {{ form_row(form.plainPassword) }}

    <button type="submit" class="button button-primary">Créer mon espace</button>
{{ form_end(form) }}

<div class="auth-links">
    <span>Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></span>
</div>

{% endblock %}
